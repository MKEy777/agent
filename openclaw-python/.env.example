# OpenClaw-Py local environment example.
# Copy this file to .env and replace placeholder values.

# Model providers. At least one provider key is needed for real model replies.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search. Optional, but recommended for deep research.
BOCHA_API_KEY=

# Gateway/runtime.
OPENCLAW_STATE_DIR=.openclaw-state
OPENCLAW_CONFIG_PATH=

# Feishu app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu webhook mode only. Not required for WebSocket long-connection mode.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Internal signed test endpoint.
OPENCLAW_FEISHU_INTERNAL_SECRET=change-me

# Feishu cloud docs.
OPENCLAW_FEISHU_DOCS_WRITE_ENABLED=false
FEISHU_DOCS_BASE_URL=https://your-company.feishu.cn
